# ==========================================
# OrbitDrop Backend Environment Variables
# ==========================================

# Server Configuration
PORT=5001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# MongoDB Database Connection
MONGODB_URI=mongodb://localhost:27017/orbitdrop
# Or for MongoDB Atlas Cloud:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/orbitdrop?retryWrites=true&w=majority

# ------------------------------------------
# External APIs (Zero-Key by Default)
# ------------------------------------------
# NASA POWER (Agroclimatology API) and Open-Meteo do not require API keys.
# If you integrate commercial or authenticated services in production, configure below:

# Optional: NASA api.nasa.gov key (if using high-volume rate-limited endpoints)
# NASA_API_KEY=your_nasa_api_key_here

# Optional: Mapbox Satellite Token (if replacing free Esri World Imagery)
# MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

# Optional: PostGIS Database (for persistent parcel & telemetry storage)
# DATABASE_URL=postgresql://orbitdrop_user:secret_password@localhost:5432/orbitdrop_db

# Optional: Authentication / JWT Signing Secret
# JWT_SECRET=replace_with_a_long_random_secret_string_32_chars_min
